{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@pages/partial/*": ["src/components/page-partials/*"],
      "@pages/*": ["src/pages/*"],
      "@planner/*": ["src/planner/*"],
      "@toolkit/*": ["src/toolkit/*"],
      "@assets/*": ["src/assets/*"],
      "@layout/*": ["src/Layouts/*"],
      "@common/*": ["src/Common/*"],
      "@components/*": ["src/components/*"],
      "@data/*": ["src/Common/JsonData/*"],
      "@slices/*": ["src/slices/*"],
      "@views/*": ["src/views/*"],
      "@helpers/*": ["src/helpers/*"],
      "@utils/*": ["src/utils/*"],
      "@services/*": ["src/services/*"],
      "@models/*": ["src/Models/*"],
      "@hooks/*": ["src/hooks/*"],
      "@crm/*": ["src/crm/*"],
      "@types/*": ["src/types/*"],
      "@typings/*": ["src/types/*"],
      "@constants/*": ["src/constants/*"],
      "@config/*": ["src/config/*"],
      "@auth/*": ["src/auth/*"],
      "next/router": ["src/shims/next-router.tsx"],
      "next/head": ["src/shims/next-head.tsx"],
      "next/link": ["src/shims/next-link.tsx"],
      "next/dynamic": ["src/shims/next-dynamic.tsx"],
      "next/image": ["src/shims/next-image.tsx"],
      "next/document": ["src/shims/next-document.tsx"],
      "next/error": ["src/shims/next-error.tsx"],
      "next/app": ["src/shims/next-app.tsx"],
      "next/server": ["src/shims/next-server.tsx"],
      "next/script": ["src/shims/next-script.tsx"],
      "next/font/google": ["src/shims/next-font.tsx"],
      "next/font/local": ["src/shims/next-font.tsx"],
      "next": ["src/shims/next-types.tsx"],
      "next-auth/react": ["src/shims/next-auth-react.tsx"],
      "next-auth/jwt": ["src/shims/next-auth-jwt.tsx"],
      "next-auth": ["src/shims/next-auth.tsx"],
      "next-i18next": ["src/shims/next-i18next.tsx"],
      "next-redux-wrapper": ["src/shims/next-redux-wrapper.tsx"],
      "@page-modules/*": ["src/page-modules/*"],
      "@query/keys": ["src/query/keys.ts"],
      "@cti": ["src/cti/index.ts"],
      "@sentry/nextjs": ["src/shims/sentry-nextjs.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "global.d.ts"],
  "exclude": ["node_modules", "src/assets/js/particles.min.js", "dist", ".next"]
}
